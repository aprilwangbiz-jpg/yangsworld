# Copy to .env.local for local dev. The same three values go in the GitHub repo
# as Actions variables (Settings → Secrets and variables → Actions → Variables).
# All three are public by design — access is enforced by supabase/setup.sql.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-key
# The shared uploader login you create under Authentication → Users
VITE_UPLOADER_EMAIL=uploader@example.com
